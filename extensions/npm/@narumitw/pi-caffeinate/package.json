{
	"name": "@narumitw/pi-caffeinate",
	"version": "0.49.3",
	"description": "Pi extension that keeps the computer awake while the agent is running.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"caffeinate",
		"awake",
		"sleep"
	],
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"check": "biome check . && npm run typecheck",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@earendil-works/pi-coding-agent": "0.83.0",
		"@types/node": "26.1.2",
		"typescript": "7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/narumiruna/pi-extensions",
		"directory": "extensions/pi-caffeinate"
	},
	"dependencies": {
		"@narumitw/pi-tui-kit": "^0.49.1"
	}
}
